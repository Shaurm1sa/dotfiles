{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
     {
      "type": "custom",
      "format": "┌────────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "display",
      "key": "│   Display "
    },
    {
      "type": "board",
      "key": "│   Motherboard "
    },
    {
      "type": "cpu",
      "key": "│   CPU "
    },
    {
      "type": "gpu",
      "key": "│   GPU "
    },
    {
      "type": "memory",
      "key": "│   RAM "
    },
    {
      "type": "swap",
      "key": "│   SWAP "
    },
    {
      "type": "disk",
      "key" : "│   DISK "
    },
    
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "│   OS "
    },
    {
      "type": "kernel",
      "key": "│   Kernel "

    },
    {
      "type":     "packages",
      "key": "│   Packages "
    },
    {
      "type":     "shell",
      "key": "│   Shell "
    },
    {
      "type":     "terminal",
      "key": "│   Terminal "
    },
    {
      "type":     "terminalfont",
      "key": "│   └Terminal Font "
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────────Uptime / Age────────────────────┐"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "│   OS Age ",
      "keyColor": "35", // Фіолетовий колір
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "│   Uptime "
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────────DM / WM───────────────────────┐"
    },
    {
      "type": "de",
      "key": "│   DE "
    },
    {
      "type": "uptime",
      "key": "│   Uptime "
    },
    {
      "type": "wm",
      "key": "│   WM "
    },
    {
      "type": "wmtheme",
      "key": "│   WM Theme "
    },
    {
      "type": "theme",
      "key": "│   Theme "
    },
    {
      "type": "icons",
      "key": "│   Icons "
    },
    {
      "type": "font",
      "key": "│   Font "
    },
    {
      "type": "cursor",
      "key": "│   Cursor "
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘"
    }
  ]
}
