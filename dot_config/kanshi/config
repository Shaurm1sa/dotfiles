# Використовуємо назви портів для надійності
output "eDP-1" {
    mode 1920x1080@60.06
    alias $INTERNAL
}

output "HDMI-A-1" {
    mode preferred
    alias $EXTERNAL
}

profile home_open {
    output $EXTERNAL enable position 0,0 scale 1.0
    output $INTERNAL enable position 1920,0 scale 1.0
}

# Профіль для дому (кришка закрита): тільки зовнішній монітор
profile home_closed {
    output $EXTERNAL enable position 0,0 scale 1.0
    output $INTERNAL disable
}

# Профіль для роботи/дороги: тільки ноутбук
profile laptop_only {
    output $INTERNAL enable position 0,0 scale 1.0
}
